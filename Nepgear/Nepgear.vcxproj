  <!-- Release DLLs ship UPX-compressed. The linker output is packed in place so
       $(TargetPath) is always the final artifact; no separate pack step is
       needed. Set NepgearSkipPack=1 (property or environment variable) to keep
       an uncompressed DLL for PDB-based debugging. -->
  <PropertyGroup>
    <NepgearUpxExe Condition="'$(NepgearUpxExe)'==''">$(ProjectDir)..\tools\upx\upx.exe</NepgearUpxExe>
    <NepgearPackStamp>$(IntDir)$(TargetName).upx.stamp</NepgearPackStamp>
    <NepgearPackEnabled>false</NepgearPackEnabled>
    <NepgearPackEnabled Condition="'$(Configuration)'=='Release' AND '$(NepgearSkipPack)'!='1' AND Exists('$(NepgearUpxExe)')">true</NepgearPackEnabled>
  </PropertyGroup>
  <!-- A stamp newer than the DLL is only trustworthy if that exact DLL is still
       packed. Drop the stamp when the output was replaced or hand-unpacked. -->
  <Target Name="NepgearPackReleaseVerifyStamp" AfterTargets="Link"
      Condition="'$(NepgearPackEnabled)'=='true' AND Exists('$(NepgearPackStamp)')">
    <Exec Command="&quot;$(NepgearUpxExe)&quot; -t --no-progress &quot;$(TargetPath)&quot;"
        ContinueOnError="true" IgnoreExitCode="true"
        StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NepgearPackedProbe" />
    </Exec>
    <Delete Files="$(NepgearPackStamp)" Condition="'$(NepgearPackedProbe)'!='0'" />
  </Target>
  <Target Name="NepgearPackRelease" AfterTargets="Link"
      DependsOnTargets="NepgearPackReleaseVerifyStamp"
      Condition="'$(NepgearPackEnabled)'=='true'"
      Inputs="$(TargetPath)" Outputs="$(NepgearPackStamp)">
    <!-- Pack a staged copy first: a failed or interrupted UPX run must never
         leave a truncated DLL in the output directory. -->
    <PropertyGroup>
      <NepgearPackStaged>$(IntDir)upx\$(TargetFileName)</NepgearPackStaged>
    </PropertyGroup>
    <MakeDir Directories="$(IntDir)upx" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(NepgearPackStaged)" />
    <Exec Command="&quot;$(NepgearUpxExe)&quot; --best --lzma --no-progress &quot;$(NepgearPackStaged)&quot;"
        StandardOutputImportance="low" />
    <Exec Command="&quot;$(NepgearUpxExe)&quot; -t --no-progress &quot;$(NepgearPackStaged)&quot;"
        StandardOutputImportance="low" />
    <Copy SourceFiles="$(NepgearPackStaged)" DestinationFiles="$(TargetPath)" />
    <Exec Command="&quot;$(NepgearUpxExe)&quot; -t --no-progress &quot;$(TargetPath)&quot;"
        StandardOutputImportance="low" />
    <Touch Files="$(NepgearPackStamp)" AlwaysCreate="true" />
    <Message Importance="high" Text="$(TargetFileName): UPX-compressed and verified -&gt; $(TargetPath)" />
  </Target>
  <!-- Without this the stamp survives a cleaned output directory and the next
       build would ship an uncompressed DLL. -->
  <Target Name="NepgearPackReleaseClean" AfterTargets="Clean">
    <Delete Files="$(NepgearPackStamp)" />
    <RemoveDir Directories="$(IntDir)upx" />
  </Target>
